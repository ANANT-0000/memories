{
  "name": "my-gallery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "lint:ci": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.types.ts",
    "check": "npm run typecheck && npm run lint && npm run build",
    "analyze:nexus": "gitnexus analyze --wal-checkpoint-threshold 67108864",
    "analyze:graph": "python -m graphify . --code-only",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "clsx": "2.1.1",
    "framer-motion": "14.9.0",
    "lucide-react": "1.65.0",
    "next": "16.4.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.90.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
