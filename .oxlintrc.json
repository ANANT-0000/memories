{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "nextjs",
    "typescript",
    "jsx-a11y",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "builtin": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "node_modules/**",
    "next-env.d.ts",
    "public/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-console": "error",
    "no-debugger": "error",
    "eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  }
}
